PORT=5000
MONGODB_URI=your_mongodb_uri
JWT_SECRET=your_super_secret_key
JWT_REFRESH_SECRET=your_refresh_secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Resend API (HTTP-based email delivery for production / Render)
RESEND_API_KEY=re_your_api_key_here
# onboarding@resend.dev can only email your own Resend account. Use your verified domain.
RESEND_FROM_EMAIL=RV Foods <no-reply@mail.rv-foods.in>

# Google Routes API (road distance). Private: never put this key in the client.
GOOGLE_MAPS_SERVER_KEY=
# Google sign-in. The same OAuth Client ID as VITE_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=

CLIENT_URL=http://localhost:5173
NODE_ENV=development
